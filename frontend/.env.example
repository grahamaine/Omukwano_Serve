# --- Browser (safe to expose; prefixed VITE_) ---
VITE_WALLETCONNECT_PROJECT_ID=      # from https://cloud.reown.com
VITE_RPC_URL=                       # optional custom devnet RPC (e.g. Helius)

# --- Server only (Vercel Environment Variables; NEVER prefix with VITE_, never commit real values) ---
# MTN MoMo Collection (https://momodeveloper.mtn.com)
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_TARGET_ENV=sandbox              # production: mtnuganda
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_CURRENCY=EUR                    # sandbox only supports EUR; production: UGX

# Airtel Money Open API (https://developers.airtel.africa)
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_PAYMENT_PATH=/merchant/v2/payments/

# Pesapal API 3.0 (https://developer.pesapal.com)
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3   # live: https://pay.pesapal.com/v3
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=                     # returned by POST /api/pay/pesapal?action=register-ipn
PUBLIC_APP_URL=https://omukwano-solana.vercel.app
